// Implicit flow: result depends on secret (compared to public input).
// If the server accepts this as "secure", each query returns 0 or 1 and you can
// binary-search the secret in ~62 queries, then confirm with probe.c0.
int main(int input, int secret)
{
    int bit = 0;
    if (secret < input) {
        bit = 1;
    } else {
        bit = 0;
    }
    return bit;
}
